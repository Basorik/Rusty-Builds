{
  "name": "rusty-builds",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tool:fetch-data": "bun run tools/fetch_data.ts",
    "tool:fetch-pob": "bun run tools/fetch_data.ts --pob",
    "tool:fetch-tree": "bun run tools/fetch_data.ts --tree",
    "tool:fetch-repoe": "bun run tools/fetch_data.ts --repoe",
    "tool:normalize-ssm": "bun run tools/normalize_skill_stat_map.ts",
    "tool:gen-ssm": "bun run tools/gen_ssm.ts",
    "tool:gen-gem-stats": "bun run tools/gen_gem_stat_table.ts",
    "tool:gen-fixtures": "bun run tools/gen_parity_fixtures.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "pixi.js": "^8.16.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "bun-types": "^1.3.10",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}